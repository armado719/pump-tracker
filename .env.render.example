# ── Pump Tracker GRS — variables para Render + Aiven ───────────────────────
# No se sube como .env: estos valores se configuran en el Dashboard de Render
# (Environment) o vía el render.yaml con "sync: false".
# Aquí solo como referencia de qué completar y de dónde sacarlo.

APP_NAME="Pump Tracker GRS"
APP_ENV=production
APP_KEY=                       # !!! php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://pump-tracker.onrender.com   # o tu dominio personalizado en Render
APP_LOCALE=es

# ── Base de datos — Aiven MySQL ──────────────────────────────────────────────
# En Aiven: Services > tu servicio MySQL > "Connection Information"
# Aiven SIEMPRE requiere SSL — descarga el "CA Certificate" desde esa misma
# pantalla y súbelo al repo como storage/aiven-ca.pem (o usa un Secret File
# en Render: Dashboard > Environment > Secret Files).
DB_CONNECTION=mysql
DB_HOST=                       # !!! ej. mysql-xxxx-tuempresa.aivencloud.com
DB_PORT=                       # !!! ej. 12691 (Aiven NO usa el 3306 por defecto)
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=                   # !!! desde "Connection Information" de Aiven
MYSQL_ATTR_SSL_CA=/var/www/html/storage/aiven-ca.pem

# ── Sesiones, caché y colas ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Correo SMTP (o configúralo desde Admin › Correo SMTP dentro de la app) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alertas@grs.com.co
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alertas@grs.com.co
MAIL_FROM_NAME="GRS Pump Tracker"

# ── Logs — Render captura stdout/stderr automáticamente ─────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=warning
