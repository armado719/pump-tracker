# ── Pump Tracker GRS — .env de PRODUCCIÓN ──────────────────────────────────
# Copiar a .env en el servidor y completar los valores marcados con !!!

APP_NAME="Pump Tracker GRS"
APP_ENV=production
APP_KEY=                          # !!! Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://pumps.tudominio.com   # !!! Cambiar al dominio real

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# ── Base de datos (MySQL recomendado en producción) ─────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pump_tracker
DB_USERNAME=pump_user             # !!! Crear usuario dedicado
DB_PASSWORD=                      # !!! Contraseña segura (mín. 16 chars)

# ── Sesiones, caché, colas ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=database

# ── Correo SMTP (también configurable desde Admin › Correo SMTP) ────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com          # o smtp.office365.com, mail.grs.com.co, etc.
MAIL_PORT=587
MAIL_USERNAME=alertas@grs.com.co  # !!! Cuenta de correo real
MAIL_PASSWORD=                    # !!! App Password de Gmail / contraseña SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alertas@grs.com.co
MAIL_FROM_NAME="GRS Pump Tracker"

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Otros (no cambiar salvo necesidad) ─────────────────────────────────────
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
